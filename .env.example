# ============================================================
# Bagdit environment variables
# Copy this file to .env.local for local development.
# On Vercel: Project → Settings → Environment Variables.
# NEVER commit .env.local — it's gitignored.
# ============================================================

# --- Supabase (Project → Settings → API) ---
# "Project URL"
SUPABASE_URL=
# "service_role" secret key (NOT the anon key). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# The password for /admin. Pick something long; you'll type it on your phone.
ADMIN_PASSWORD=

# Signs creator login cookies. Any long random string.
SESSION_SECRET=

# --- Email notifications (Resend) ---
# From resend.com → API Keys. Emails go to hello@bagdit.app.
# Without this key the app still works; it just logs instead of emailing.
RESEND_API_KEY=

# Where notifications are sent (default hello@bagdit.app)
NOTIFY_EMAIL=hello@bagdit.app
# Verified sender (Resend domain = send.bagdit.app subdomain records only)
NOTIFY_FROM=Bagdit <notify@send.bagdit.app>

# --- Outreach (Zoho Mail Lite: SMTP + IMAP) ---
# Zoho app-specific password (accounts.zoho.com → Security → App Passwords)
ZOHO_APP_PASSWORD=
ZOHO_USER=hello@bagdit.app
# Outreach sends per day (code hard-caps at 15 regardless)
MAX_DAILY_SENDS=5
# Physical mailing address for the CAN-SPAM footer
MAILING_ADDRESS=
# Shared secret between the GitHub Actions cron and /api/outreach-tick
OUTREACH_CRON_SECRET=
